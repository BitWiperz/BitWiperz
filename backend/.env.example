# Backend environment variables

# Server
PORT=3000

# Auth
# REQUIRED: Set a strong random secret. No default.
# Generate one: openssl rand -hex 32
JWT_SECRET=
# Default reduced to 24h for desktop app
JWT_EXPIRES_IN=24h
# Configure bcrypt salt rounds (default 12)
BCRYPT_ROUNDS=12

# Supabase
# Set your project URL and Service Role key (placeholders)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
# Optional: publishable anon key (for client-side use)
SUPABASE_ANON_KEY=

# Certificates branding (optional)
CERT_COMPANY_NAME=BitWiperz
# Path to a PNG/JPG logo to embed in PDFs
# CERT_LOGO_PATH=./data/logo.png

# CORS: comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:1420

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_MAX_AUTH=50

# Environment
NODE_ENV=development
